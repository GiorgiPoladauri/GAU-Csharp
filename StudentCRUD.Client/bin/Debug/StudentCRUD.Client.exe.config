<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IStudentService"
                 maxReceivedMessageSize="20000000"
                 maxBufferSize="20000000" />
      </basicHttpBinding>
    </bindings>
    <client>
      <!-- address = სერვისი სად მუშაობს (StudentCRUD.Service პროექტი უნდა გაშვებული იყოს) -->
      <endpoint address="http://localhost:8080/StudentService"
                binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_IStudentService"
                contract="StudentCRUD.Service.IStudentService"
                name="BasicHttpBinding_IStudentService" />
    </client>
  </system.serviceModel>
</configuration>
