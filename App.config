<?xml version="1.0" encoding="utf-8" ?>
<!--
  App.config — WCF Behaviors Demo
  
  Most WCF config is done PROGRAMMATICALLY in Program.cs for this demo
  so that the code is self-explanatory during the presentation.
  
  However, this file is still required for:
    - Enabling detailed WCF diagnostic tracing (optional, but useful)
    - .NET framework version targeting
-->
<configuration>

  <startup>
    <!-- Target .NET Framework 4.x — required for System.ServiceModel (WCF) -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    OPTIONAL: Enable WCF tracing to SvcTraceViewer
    Uncomment the section below if you want to inspect raw SOAP messages
    in the Microsoft Service Trace Viewer tool (SvcTraceViewer.exe).
    
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel"
              switchValue="Information, ActivityTracing"
              propagateActivity="true">
        <listeners>
          <add name="traceListener"
               type="System.Diagnostics.XmlWriterTraceListener"
               initializeData="WcfTrace.svclog" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
  -->

  <!--
    NOTE: No <system.serviceModel> section here by design.
    Endpoints, bindings, and behaviors are all added in code (Program.cs)
    so the demo is fully readable without jumping between code and config.
    
    In production you would typically configure endpoints here:
    
  <system.serviceModel>
    <services>
      <service name="WcfBehaviorsDemo.Services.CalculatorService"
               behaviorConfiguration="calculatorBehavior">
        <endpoint address="basic"
                  binding="basicHttpBinding"
                  contract="WcfBehaviorsDemo.Contracts.ICalculatorService"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8080/CalculatorService"/>
          </baseAddresses>
        </host>
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="calculatorBehavior">
          <serviceMetadata httpGetEnabled="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  -->

</configuration>
