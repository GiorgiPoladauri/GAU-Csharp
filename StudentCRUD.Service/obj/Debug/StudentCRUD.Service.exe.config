<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <!-- ======================== DATABASE CONNECTION ======================== -->
  <connectionStrings>
    <!--
      name="SchoolDB"          → SchoolDbContext-ში base("SchoolDB")-ს შეესაბამება
      Data Source=(localdb)\.. → Visual Studio-ს ჩაშენებული SQL სერვერი
      Initial Catalog=SchoolDB → ბაზის სახელი (EF ავტომატურად შექმნის)
      Integrated Security=True → Windows Authentication (password არ სჭირდება)
    -->
    <add name="SchoolDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SchoolDB;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <!-- ======================== ENTITY FRAMEWORK ======================== -->
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient"
                type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <!-- ======================== WCF SERVICE ======================== -->
  <system.serviceModel>
    <services>
      <service name="StudentCRUD.Service.StudentService"
               behaviorConfiguration="StudentServiceBehavior">

        <!-- მთავარი endpoint: კლიენტი ამ მისამართით უკავშირდება -->
        <endpoint address=""
                  binding="basicHttpBinding"
                  contract="StudentCRUD.Service.IStudentService" />

        <!-- Metadata endpoint: კლიენტს საშუალებას აძლევს "Add Service Reference" გამოიყენოს -->
        <endpoint address="mex"
                  binding="mexHttpBinding"
                  contract="IMetadataExchange" />

        <!-- სერვისი ამ მისამართზე "გაიხსნება" -->
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8080/StudentService" />
          </baseAddresses>
        </host>
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior name="StudentServiceBehavior">
          <!-- httpGetEnabled=true: /wsdl URL-ზე სქემა ხელმისაწვდომია -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="false" />
          <!-- includeExceptionDetailInFaults=true: Debug-ისთვის შეცდომის დეტალები -->
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

</configuration>
